# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337 AS python-runtime
FROM postgres:17-bookworm@sha256:839fbb5a4942a7758dd93e18b42ea5649807491a0545b5eeeb8f0b8bb11857a5
# Local/offline administration image. PostgreSQL is never started by the default CMD.
COPY --from=python-runtime /usr/local/ /usr/local/
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN rm -f /etc/apt/sources.list.d/pgdg.list /etc/apt/sources.list.d/pgdg.sources && apt-get update && apt-get install -y --no-install-recommends fonts-dejavu-core libexpat1 libbz2-1.0 liblzma5 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt constraints.txt ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -s /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi; \
    pip install --no-cache-dir -r requirements.txt httpx==0.28.1
COPY app.js sync.js decisions.js calendar.js writeoff_analytics.js index.html styles.css ./
COPY server/ ./server/
RUN chmod -R a+rX /app && groupadd --gid 1000 ksu && useradd --uid 1000 --gid 1000 --no-create-home ksu
USER 1000:1000
EXPOSE 8000
CMD ["python","-m","server.pg_runtime"]

# Non-secret settings only; actual values are set by the deployment agent in Amvera.
KSU_DB=/data/ksu.sqlite3
KSU_ORIGIN=https://ksu.example.org
KSU_SECURE_COOKIES=1
KSU_REQUIRE_INITIALIZED=1
KSU_DB_MAX_BYTES=268435456
KSU_DATA_MAX_BYTES=2147483648
KSU_BACKUP_KEEP=2
KSU_CONCURRENCY_LIMIT=16
# KSU_BOOTSTRAP_DEMO=1 is supplied only for the explicitly approved first startup.

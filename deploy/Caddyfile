# Пример: замените домен на согласованный корпоративный, настройте DNS и TLS.
# Не публикуйте демонстрационную систему без согласования.
ksu.example.org {
	handle /api/decision-imports {
		request_body {
			max_size 30000000
		}
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		request_body {
			max_size 6000000
		}
		reverse_proxy 127.0.0.1:8000
	}
}
